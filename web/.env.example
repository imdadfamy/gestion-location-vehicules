# Copier en .env.local. En développement, seule la stack Supabase locale est acceptée.
# La clé anon locale est la clé de démo publique de la CLI ; ne jamais mettre de clé service_role ici.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Adresse publique du site (liens et images de partage).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
